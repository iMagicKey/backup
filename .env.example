# -----------------------------------------------------------------------------
# Backup service configuration. Copy to .env (`npm run init` does this),
# fill in your values and keep the file private: `chmod 600 .env`.
# Lists accept either comma-separated values or a JSON array.
# -----------------------------------------------------------------------------

# live | dev — selects app/config/<APP_ENV>/ (logger and scheduler settings)
APP_ENV=live

# Scheduler tick in milliseconds (optional; defaults to app/config/<APP_ENV>/scheduler.json)
# SCHEDULER_INTERVAL=15000

# --- General -----------------------------------------------------------------
# Files and directories to archive (leave empty to back up databases only)
BACKUP_PATHS=/etc,/var/www
# tar --exclude patterns
BACKUP_EXCLUDES=node_modules,*.log,.cache
# Periods to keep: minutely, hourly, daily, weekly, monthly, yearly
BACKUP_PERIODS=daily,weekly,monthly
# Override how many backups to keep per period (defaults: minutely 60, hourly 24, daily 3, weekly 5, monthly 12, yearly 15)
# BACKUP_RETENTION={"daily":7,"weekly":4}
# gzip | zstd (zstd is much faster at a better ratio and recommended when installed)
BACKUP_COMPRESSION=zstd
# zstd level 1-22 (default 19; 3-10 is a good trade-off for large data sets)
BACKUP_ZSTD_LEVEL=19
# Local bundle name prefix: <prefix><YYYY-MM-DD_HH-mm>.tar
BACKUP_PREFIX=backup-
# Name of the per-server folder in Google Drive (default: hostname in upper case)
# BACKUP_SERVER_NAME=MY-SERVER
# Working directory for archives (default: app/storage). Needs free space for about twice the size of one backup.
# BACKUP_STORAGE_DIR=/var/backups/backup-service
# Keep the latest bundle on disk until the next run (default: true)
# BACKUP_KEEP_LOCAL=true
# Kill any single dump/archive command after this many minutes (default: 360)
# BACKUP_TIMEOUT_MINUTES=360
# Retry a failed period after this many minutes (default: 15)
# BACKUP_RETRY_MINUTES=15
# Docker CLI used for *_DOCKER_CONTAINER (default: docker)
# DOCKER_COMMAND=docker

# --- MariaDB / MySQL ---------------------------------------------------------
MARIADB_ENABLED=false
# true = all databases (incl. users, routines, events); false = only MARIADB_DATABASE
MARIADB_ALL=false
# Run mariadb-dump inside this container (docker exec) instead of on the host
# MARIADB_DOCKER_CONTAINER=mariadb
# Leave HOST/PORT empty to use the default local socket (recommended in Docker mode)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=backup
MARIADB_PASSWORD=change-me
# One or more databases (comma-separated)
MARIADB_DATABASE=app
# Extra mariadb-dump arguments, e.g. --skip-routines or --ignore-table=app.sessions
# MARIADB_EXTRA_ARGS=
# Force a specific dump binary (default: mariadb-dump, falling back to mysqldump)
# MARIADB_DUMP_COMMAND=mysqldump

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_ENABLED=false
# true = pg_dumpall (all databases + roles, plain SQL); false = pg_dump of each POSTGRES_DATABASE (custom format)
POSTGRES_ALL=false
# POSTGRES_DOCKER_CONTAINER=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=app
# POSTGRES_EXTRA_ARGS=--exclude-table-data=audit_log

# --- MongoDB -----------------------------------------------------------------
MONGODB_ENABLED=false
# Optional in Docker mode (mongodump then connects to localhost inside the container)
MONGODB_URI=mongodb://backup:change-me@127.0.0.1:27017/?authSource=admin
# MONGODB_DOCKER_CONTAINER=mongo
# MONGODB_EXTRA_ARGS=--db=app

# --- Google Drive ------------------------------------------------------------
# OAuth client of type "Desktop app" from Google Cloud Console
GOOGLE_APP={"clientId":"1234567890-abc.apps.googleusercontent.com","clientSecret":"GOCSPX-replace-me","redirectURL":"http://localhost"}
# Output of `npm run create-auth`
GOOGLE_AUTH={"refresh_token":"replace-me"}
# Optional parent folder ID (default: root of My Drive)
# GOOGLE_DRIVE_FOLDER_ID=

# --- Telegram notifications --------------------------------------------------
TELEGRAM_REPORT_ENABLED=false
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHANNEL_ID=-1001234567890
# Also notify after every successful backup (default: errors and warnings only)
# TELEGRAM_REPORT_SUCCESS=false
